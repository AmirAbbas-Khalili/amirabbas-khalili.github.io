---
interface Props {
  message?: string;
}

const { message = 'Content for this part is being prepared and will appear here soon.' } =
  Astro.props;
---

<div
  class="reveal flex items-start gap-4 rounded-[var(--radius-card)] border border-dashed border-line-strong bg-surface/60 p-6"
>
  <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-accent/10 text-accent">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2v4"></path>
      <path d="m16.2 7.8 2.9-2.9"></path>
      <path d="M18 12h4"></path>
      <path d="m16.2 16.2 2.9 2.9"></path>
      <path d="M12 18v4"></path>
      <path d="m4.9 19.1 2.9-2.9"></path>
      <path d="M2 12h4"></path>
      <path d="m4.9 4.9 2.9 2.9"></path>
    </svg>
  </span>
  <p class="max-w-xl text-sm leading-relaxed text-ink-mute">{message}</p>
</div>
