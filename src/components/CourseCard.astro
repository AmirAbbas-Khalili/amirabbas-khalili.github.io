---
import type { CollectionEntry } from 'astro:content';
import { courseView } from '../data/course-content';
interface Props { entry: CollectionEntry<'courses'> }
const { entry } = Astro.props;
const d = entry.data;
const view = courseView(entry);
---
<article data-course-card class="group relative flex h-full flex-col rounded-[var(--radius-card)] border border-line bg-surface p-6 shadow-card transition-all duration-300 hover:-translate-y-1 hover:border-line-strong hover:shadow-lift sm:p-7">
  {!view.published && <div class="flex justify-end"><span class="chip border-line bg-canvas text-ink-faint"><span class="size-1.5 rounded-full bg-aqua"></span>Soon</span></div>}
  <h3 class="mt-3 font-display text-xl font-semibold tracking-tight">{view.published ? <a href={`/courses/${entry.id}/`} class="transition-colors hover:text-accent">{d.title}</a> : d.title}{view.published && <span data-course-complete class="ml-2 inline-flex align-middle text-accent" role="img" aria-label="Published and complete"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m7 12 3 3 7-7" fill="none" stroke="var(--color-surface, #fff)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>}{view.published && view.links.some(link => /youtube\.com|youtu\.be/.test(link.url)) && <span data-course-video class="ml-2 inline-flex align-middle text-accent" role="img" aria-label="Video available on YouTube"><svg width="20" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 5 3-5 3Z" fill="currentColor" stroke="none"/></svg></span>}</h3>
  <p class="mt-3 text-sm leading-relaxed text-ink-mute">{d.summary}</p>
  {view.published && <a href={`/courses/${entry.id}/`} class="mt-auto inline-flex items-center gap-2 pt-4 text-sm text-ink-faint transition-colors hover:text-accent" aria-label={`Open ${d.title}`}>View tutorial <span class="course-link-arrow" aria-hidden="true">→</span></a>}
</article>
