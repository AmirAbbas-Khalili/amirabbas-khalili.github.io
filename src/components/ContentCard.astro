---
interface Props {
  title: string;
  desc?: string;
  href?: string;
  meta?: string;
  status?: 'coming-soon' | 'in-progress' | null;
  icon?: string[];
  tintClass?: string;
  arrow?: boolean;
}

const { title, desc, href, meta, status = null, icon, tintClass, arrow = true } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    'group relative flex h-full flex-col rounded-[var(--radius-card)] border border-line bg-surface p-6 shadow-card transition-all duration-300 sm:p-7',
    href && 'cursor-pointer hover:-translate-y-1 hover:border-line-strong hover:shadow-lift',
  ]}
>
  {
    status && (
      <div class="flex items-center justify-end">
        {status === 'coming-soon' && (
          <span class="chip border-line bg-canvas text-ink-faint">
            <span class="size-1.5 rounded-full bg-aqua"></span>
            Soon
          </span>
        )}
        {status === 'in-progress' && (
          <span class="chip border-accent/25 bg-accent/5 text-accent">
            <span class="size-1.5 animate-pulse rounded-full bg-accent"></span>
            In progress
          </span>
        )}
      </div>
    )
  }

  <div class:list={['flex items-start gap-4', !status && 'items-center']}>
    {
      icon && (
        <span
          class:list={[
            'flex size-11 shrink-0 items-center justify-center rounded-xl transition-transform duration-300',
            tintClass ?? 'bg-accent/10 text-accent',
            href && 'group-hover:scale-105',
          ]}
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {icon.map((d) => (
              <path d={d} />
            ))}
          </svg>
        </span>
      )
    }
    <h3
      class:list={[
        'font-display text-xl font-semibold tracking-tight',
        icon ? '' : 'mt-3',
        href && 'transition-colors duration-300 group-hover:text-accent',
      ]}
    >
      {title}
    </h3>
  </div>

  {
    desc && (
      <p class="mt-3 text-sm leading-relaxed text-ink-mute">
        {desc}
      </p>
    )
  }

  <div class="flex flex-1 items-end justify-between gap-3 pt-4">
    {meta && <p class="mono-label text-[10px] text-ink-faint">{meta}</p>}
    {
      href && arrow && (
        <span
          class="ml-auto inline-flex text-ink-faint transition-all duration-300 group-hover:translate-x-1 group-hover:text-accent"
          aria-hidden="true"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="m13 6 6 6-6 6"></path>
          </svg>
        </span>
      )
    }
  </div>
</Tag>
